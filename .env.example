# Copy this file to .env and fill in the values.
PORT=3000
NODE_ENV=development

# Launch moment. 21 Nov 2026 00:00 in Zimbabwe time (UTC+02:00).
LAUNCH_DATE=2026-11-21T00:00:00+02:00

# Front-end address(es) allowed to call this API (comma separate several).
# Set this to your website URL in Render.
CORS_ORIGIN=http://localhost:5173

# Gmail sending account. EMAIL_PASS must be a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Luzara Nova Website
# Recipient address for contact and guess form submissions
NOTIFY_TO=

# Key for the admin page (frontend admin.html). Use something long and private.
ADMIN_KEY=change-this-to-a-long-random-string
